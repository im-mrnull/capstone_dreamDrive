# External clones (recreated by scripts/patch_trajectronpp.py setup steps)
third_party/

# Trajectron++ training logs / per-epoch checkpoints (large; metrics JSON is the artifact)
outputs/trajectronpp_world/logs/
outputs/trajectronpp_world_hetero/logs/
# Env pickles are regenerated by scripts/6_export_trajectronpp_world.py
outputs/trajectronpp_world/*.pkl
outputs/trajectronpp_world_hetero/*.pkl

# Benchmark v2 model checkpoints (large; the per-seed metrics JSONs are the artifacts)
outputs/benchmark_v2/*.pt
outputs/benchmark_v2/mlp_best_seed*.npz
# Conformal prediction dumps (intermediate; regenerated from checkpoints by
# dump_predictions.py / 7_..._--dump-preds; conformal_metrics.json is the artifact)
outputs/benchmark_v2/preds_*.npz
# Seed-1/2 dumps for the seed-pooled bootstrap (bootstrap_ci.json is the artifact)
outputs/benchmark_v2/seed_dumps/
# Closed-loop dense windows + predictions (regenerable; closed_loop.json is the artifact)
outputs/closed_loop/
# Cross-validation fold models: checkpoints, weights and dumps (the *_seed0.json metrics are tracked)
outputs/cv_folds/**/*.pt
outputs/cv_folds/**/*.npz
outputs/cv_folds/*/dumps/

# Python
__pycache__/
*.pyc
.venv*/
.pytest_cache/

# OS noise
Thumbs.db
.DS_Store

# Obsidian per-user UI state (the vault notes in docs/ are tracked)
docs/.obsidian/workspace.json

# Internal planning notes: local only, never in the public repo
docs/output/*novelty-and-ip-roadmap*.md
docs/raw/2026-10-26-claude-project-review.md
docs/wiki/chaos-gap.md
docs/wiki/rss-violations.md
Review1-phase3_ppt*.pdf

# External datasets downloaded for comparison/visualization (licensed separately)
data_external/
# Rendered visualization frames/videos (large; regenerate with scripts/viz_*)
outputs/viz/
